{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd projects/GaussianExample-URP/Web && npm ci",
  "buildCommand": "cd projects/GaussianExample-URP/Web && npm run build",
  "outputDirectory": "projects/GaussianExample-URP/Web/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/samples/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
